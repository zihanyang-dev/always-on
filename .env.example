DATABASE_URL=postgresql://postgres:postgres@localhost:5432/always_on
HOST=127.0.0.1
PORT=3001
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# LOG_LEVEL=info
# OTEL_SERVICE_NAME=always-on-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Enable providers by setting both values in the corresponding pair.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Enable email login and workspace invitation delivery.
# RESEND_API_KEY=
# EMAIL_FROM="Always On <login@example.com>"

# Required for pnpm test:integration. Use a test PostgreSQL instance.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

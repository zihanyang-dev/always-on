# Local API and Worker. Production injects these values without this file.
NODE_ENV=development
APP_NAME=Always On
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# Dedicated development ports avoid changing existing local databases.
DATABASE_URL=postgresql://always_on:always_on_local@localhost:15432/always_on
REDIS_URL=redis://localhost:16379
REDIS_PREFIX=always-on

# Worker only. Limits are positive integers; intervals are milliseconds.
WORKER_CONCURRENCY=4

# API only. init:local generates the authentication secret without overwriting existing files.
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=generate-on-init

# Optional login providers: configure each client ID and secret together.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Email/password login is enabled when Resend is configured.
# The test sender only delivers to the email associated with the Resend account.
# RESEND_API_KEY=
EMAIL_FROM="Always On <onboarding@resend.dev>"

# API and Worker cloud execution. Omit provider credentials to disable execution endpoints.
# DEEPSEEK_API_KEY=
# AGENT_SESSION_DIRECTORY=/absolute/path/to/always-on/.local/agent-sessions

# Hosted E2B needs its API key. Self-hosted Embed generates a local key; see deploy/e2b/README.md.
# E2B_API_KEY=
# E2B_API_URL=http://127.0.0.1:43000
# E2B_SANDBOX_URL=http://127.0.0.1:43002

# Optional provider connections. Values reference environment variable NAMES, never inline secrets.
# MODEL_PROVIDERS='[{"provider":"deepseek","credentialEnvironmentKey":"DEEPSEEK_API_KEY"}]'
# Other providers supported by Pi can be added here with their own credential variable.
# DEFAULT_MODEL_PROVIDER=deepseek
# DEFAULT_MODEL_ID=deepseek-flash

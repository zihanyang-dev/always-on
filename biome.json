{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!!**/dist", "!!**/node_modules", "!!references", "!!docs", "!!AGENTS.md"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noBannedTypes": "error",
        "noExcessiveNestedCallbacks": {
          "level": "error",
          "options": {
            "max": 2
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 3
          }
        }
      },
      "correctness": {
        "noUndeclaredDependencies": "error"
      },
      "nursery": {
        "noExcessiveNestedBlocks": {
          "level": "error",
          "options": {
            "max": 3
          }
        },
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "noUnsafeReturn": "error",
        "useExhaustiveSwitchCases": {
          "level": "error",
          "options": {
            "requireExplicitCase": true
          }
        }
      },
      "performance": {
        "noReExportAll": "error"
      },
      "style": {
        "useBlockStatements": "off",
        "useImportType": "error",
        "noCommonJs": "error",
        "noNonNullAssertion": "error",
        "noDefaultExport": "error",
        "noEnum": "error",
        "noNamespace": "error",
        "noNestedTernary": "error",
        "noParameterProperties": "error",
        "noProcessEnv": "error",
        "noUselessElse": "error",
        "useExportType": "error",
        "useThrowOnlyError": "error"
      },
      "suspicious": {
        "noConfusingVoidType": "error",
        "noEmptyBlockStatements": "error",
        "noExplicitAny": "error",
        "noTsIgnore": "error",
        "noImportCycles": {
          "level": "error",
          "options": {
            "ignoreTypes": false
          }
        }
      },
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/server/src/infrastructure/database/database.types.ts"],
      "formatter": { "enabled": false }
    },
    {
      "includes": [
        "apps/server/src/entrypoints/api.ts",
        "apps/server/src/entrypoints/worker.ts",
        "apps/server/migrations/run.ts",
        "tests/integration/*.ts"
      ],
      "linter": { "rules": { "style": { "noProcessEnv": "off" } } }
    },
    {
      "includes": ["**/*.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/node_modules",
      "!!references",
      "!!pnpm-lock.yaml",
      "!!apps/server/migrations",
      "!!docs",
      "!!AGENTS.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noBannedTypes": "error",
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 3
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error"
      },
      "style": {
        "useBlockStatements": "off",
        "useImportType": "error",
        "noNonNullAssertion": "error",
        "noDefaultExport": "error",
        "noEnum": "error",
        "noNamespace": "error",
        "noNestedTernary": "error",
        "noParameterProperties": "error",
        "noProcessEnv": "error",
        "noUselessElse": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "e2b": {
                "importNames": ["NotFoundError"],
                "message": "E2B deprecated NotFoundError. Use SandboxNotFoundError or FileNotFoundError for the operation being handled."
              }
            }
          }
        },
        "useExportType": "error"
      },
      "suspicious": {
        "noConfusingVoidType": "error",
        "noExplicitAny": "error",
        "noTsIgnore": "error",
        "noImportCycles": {
          "level": "error",
          "options": {
            "ignoreTypes": false
          }
        }
      },
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/server/src/bootstrap/api.ts",
        "apps/server/src/bootstrap/worker.ts",
        "apps/server/src/bootstrap/migrate.ts",
        "apps/server/drizzle.config.ts",
        "apps/cli/src/bootstrap.ts",
        "tests/**/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/**/*.ts", "apps/web/src/**/*.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    }
  ]
}

{
  "name": "@always-on/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local src/entrypoints/api.ts",
    "start": "node src/entrypoints/api.ts",
    "db:migrate": "node --env-file-if-exists=../../.env.local migrations/run.ts",
    "db:migration:create": "node-pg-migrate create --migration-file-language sql --migration-filename-format utc",
    "db:types": "node --env-file-if-exists=../../.env.local migrations/generate-types.ts",
    "db:types:check": "node --env-file-if-exists=../../.env.local migrations/generate-types.ts --verify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@hono/zod-validator": "0.9.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "better-auth": "1.7.27",
    "hono": "4.13.19",
    "kysely": "0.29.9",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "standardwebhooks": "1.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "kysely-codegen": "0.20.0",
    "node-pg-migrate": "9.0.0"
  }
}

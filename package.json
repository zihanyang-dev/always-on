{
  "name": "always-on",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "check": "biome check --error-on-warnings . && pnpm typecheck && pnpm lint:boundaries && pnpm test",
    "lint:boundaries": "node scripts/check-boundaries.ts",
    "test": "node --test scripts/*.test.ts apps/server/src/entrypoints/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env.local --test tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @always-on/server typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "rolldown": "1.3.3",
    "typescript": "7.0.2"
  }
}

{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "lib": ["ES2024", "DOM", "ESNext.Disposable"],
    "types": ["node"]
  },
  "include": [
    "../apps/**/*.test.ts",
    "../apps/web/src/app/i18next.d.ts",
    "../packages/**/*.test.ts",
    "./**/*.ts",
    "../*.config.ts"
  ],
  "exclude": ["../node_modules", "../references"]
}
